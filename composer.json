{
    "name": "jidaikobo/kontiki",
    "description": "A portable, Composer-managed CMS with an explicit installer CLI.",
    "type": "library",
    "authors": [
        {
            "name": "jidaikobo-shibata",
            "email": "shibata@jidaikobo.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "jidaikobo/kontiki-framework": "^0.9.64",
        "symfony/console": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Jidaikobo\\Kontiki\\Cli\\": "src/Cli/"
        }
    },
    "bin": [
        "bin/kontiki"
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "audit": {
            "block-insecure": true
        },
        "bin-dir": "bin",
        "sort-packages": true
    }
}
