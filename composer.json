{
    "name": "jidaikobo/kontiki",
    "description": "Composer project installer for Kontiki CMS 0.9.",
    "type": "project",
    "authors": [
        {
            "name": "jidaikobo-shibata",
            "email": "shibata@jidaikobo.com"
        }
    ],
    "scripts": {
        "post-create-project-cmd": [
            "@php scripts/install.php"
        ]
    },
    "license": "MIT",
    "require": {
        "jidaikobo/kontiki-framework": "^0.9.63"
    },
    "config": {
        "audit": {
            "block-insecure": true
        },
        "bin-dir": "bin",
        "sort-packages": true
    }
}
